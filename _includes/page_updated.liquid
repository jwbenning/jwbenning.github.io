{% comment %}
  Per-page "last updated" stamp.

  Date comes from git via _plugins/git-last-updated.rb, so it reflects when THIS
  page's source file actually changed — not the build time. The site-wide
  `last_updated` flag in _config.yml is deliberately left false: it renders
  'now' into every page's footer, which would date untouched pages to the most
  recent deploy.

  Override per page with `last_updated: 2026-08-31` in front matter when the
  git date is misleading (e.g. a whitespace-only commit).
{% endcomment %}
{% assign stamp = page.last_updated | default: page.git_updated %}
{% if stamp %}
  <p class="page-updated">Last updated {{ stamp | date: '%B %-d, %Y' }}</p>
{% endif %}
