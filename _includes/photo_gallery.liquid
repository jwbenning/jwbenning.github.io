{% comment %}
  Photo gallery — auto-discovers every image in assets/img/photos/.

  To add a photo: drop the file in assets/img/photos/ and commit. That's it.
  Name it YYYY-MM-DD_short-slug.jpg so it sorts newest-first and gets a
  readable fallback caption ("short slug").

  Optional: add a caption in _data/photos.yml, keyed by filename.

  Params:
    limit  — show only the N most recent (omit to show all)
{% endcomment %}

{% assign gallery_photos = site.static_files
  | where_exp: "f", "f.path contains '/assets/img/photos/'"
  | where_exp: "f", "f.extname == '.jpg' or f.extname == '.jpeg' or f.extname == '.png'"
  | sort: "name"
  | reverse
%}

{% if include.limit and gallery_photos.size > include.limit %}
  {% assign gallery_photos = gallery_photos | slice: 0, include.limit %}
{% endif %}

{% if gallery_photos.size > 0 %}
  <div class="photo-grid">
    {% for photo in gallery_photos %}
      {% assign meta = site.data.photos | where: "file", photo.name | first %}

      {% comment %}Fallback caption: drop a leading YYYY-MM-DD_ from the filename, then unslugify.{% endcomment %}
      {% assign name_parts = photo.basename | split: "_" %}
      {% if name_parts.size > 1 and name_parts[0].size == 10 %}
        {% assign stem = name_parts | slice: 1, 50 | join: " " %}
      {% else %}
        {% assign stem = photo.basename %}
      {% endif %}
      {% assign alt_text = stem | replace: "-", " " | replace: "_", " " %}

      <figure class="photo-grid-item">
        {%
          include figure.liquid
          path=photo.path
          class="img-fluid rounded z-depth-1"
          sizes="(min-width: 768px) 30vw, 90vw"
          alt=alt_text
          zoomable=true
        %}
        {% if meta.caption %}
          <figcaption class="caption">{{ meta.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>
{% endif %}
