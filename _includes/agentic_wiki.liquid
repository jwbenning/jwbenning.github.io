{% comment %}
  Shared styling, section nav and footer for the /agentic/ guides.

  Include once near the top of every page in the section. A page declares itself a
  child by setting `wiki_slug: <slug>` in its front matter; the hub omits it and gets
  neither breadcrumb nor nav, because its card grid does that job. The nav itself is
  driven by _data/agentic_wiki.yml, so adding a page is a data edit plus a new
  _pages file.

  The authorship line is rendered here rather than written into each page, so it
  cannot drift between pages or be forgotten on a new one.
{% endcomment %}

<style>
  .wk-crumb {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
    margin: 0 0 0.9rem;
  }
  .wk-crumb a {
    color: var(--global-text-color-light);
  }
  .wk-crumb a:hover {
    color: var(--global-theme-color);
  }

  .wk-nav {
    border: 1px solid var(--global-divider-color);
    border-radius: 12px;
    background: var(--global-card-bg-color);
    padding: 0.9rem 1.2rem;
    margin: 0 0 2rem;
  }
  .wk-nav ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: wk;
  }
  .wk-nav li {
    counter-increment: wk;
    margin: 0 0 0.25rem;
    line-height: 1.45;
  }
  .wk-nav li:last-child {
    margin-bottom: 0;
  }
  .wk-nav li::before {
    content: counter(wk) '.';
    color: var(--global-text-color-light);
    font-size: 0.82rem;
    margin-right: 0.4rem;
  }
  .wk-nav li.is-here {
    font-weight: 700;
  }
  .wk-nav li.is-here::before {
    color: var(--global-theme-color);
  }
  .wk-nav a {
    color: var(--global-text-color);
  }
  .wk-nav a:hover {
    color: var(--global-theme-color);
  }

  .wk-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.9rem;
    margin: 1.4rem 0 0;
  }
  .wk-card {
    border: 1px solid var(--global-divider-color);
    border-radius: 12px;
    background: var(--global-card-bg-color);
    padding: 1rem 1.1rem;
    transition: border-color 0.15s ease;
  }
  .wk-card:hover {
    border-color: var(--global-theme-color);
  }
  .wk-card .t {
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.3;
    margin: 0 0 0.3rem;
  }
  .wk-card .t a {
    color: var(--global-text-color);
  }
  .wk-card .t a:hover {
    color: var(--global-theme-color);
  }
  .wk-card p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  .wk-note,
  .wk-warn {
    border: 1px solid var(--global-divider-color);
    border-left: 4px solid var(--global-theme-color);
    border-radius: 10px;
    background: var(--global-card-bg-color);
    padding: 0.85rem 1.1rem;
    margin: 1.4rem 0;
    line-height: 1.6;
  }
  .wk-warn {
    border-left-color: #b4541e;
  }
  .wk-note p:last-child,
  .wk-warn p:last-child {
    margin-bottom: 0;
  }
  .wk-note .lbl,
  .wk-warn .lbl {
    display: block;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-theme-color);
    margin-bottom: 0.25rem;
  }
  .wk-warn .lbl {
    color: #b4541e;
  }

  .wk-byline {
    border-top: 1px solid var(--global-divider-color);
    margin-top: 2.5rem;
    padding-top: 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  /* Wide tables scroll inside their own box rather than pushing the page sideways. */
  .post table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  .post h2 {
    margin-top: 2.4rem;
  }
  .post h3 {
    margin-top: 1.7rem;
  }
  .post pre {
    border-radius: 8px;
  }
  body h2[id] {
    scroll-margin-top: 7rem;
  }
</style>

{% assign w = site.data.agentic_wiki %}

{% if page.wiki_slug %}
  <p class="wk-crumb"><a href="{{ '/agentic/' | relative_url }}">← agentic ai</a></p>

  <nav class="wk-nav" aria-label="Guides in this section">
    <ol>
      {% for p in w.pages %}
        <li
          {% if p.slug == page.wiki_slug %}
            class="is-here"
          {% endif %}
        >
          {% if p.slug == page.wiki_slug %}
            {{ p.title }}
          {% else %}
            <a href="{{ '/agentic/' | append: p.slug | append: '/' | relative_url }}">{{ p.title }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
